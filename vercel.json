{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(duel\\.mjs|play\\.ps1|play\\.sh)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/duel.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/race/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*PowerShell.*"
        }
      ],
      "destination": "/api/duel?a=launch&sh=ps&cmd=race&id=:id"
    },
    {
      "source": "/race/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(curl|Wget).*"
        }
      ],
      "destination": "/api/duel?a=launch&sh=sh&cmd=race&id=:id"
    },
    {
      "source": "/duel/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*PowerShell.*"
        }
      ],
      "destination": "/api/duel?a=launch&sh=ps&cmd=join&id=:id"
    },
    {
      "source": "/duel/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(curl|Wget).*"
        }
      ],
      "destination": "/api/duel?a=launch&sh=sh&cmd=join&id=:id"
    },
    {
      "source": "/fight/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*PowerShell.*"
        }
      ],
      "destination": "/api/duel?a=launch&sh=ps&cmd=fight&id=:id"
    },
    {
      "source": "/fight/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(curl|Wget).*"
        }
      ],
      "destination": "/api/duel?a=launch&sh=sh&cmd=fight&id=:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*PowerShell.*"
        }
      ],
      "destination": "/play.ps1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(curl|Wget).*"
        }
      ],
      "destination": "/play.sh"
    },
    {
      "source": "/ps",
      "destination": "/play.ps1"
    },
    {
      "source": "/sh",
      "destination": "/play.sh"
    },
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/app.html"
    }
  ]
}