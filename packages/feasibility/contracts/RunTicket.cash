pragma cashscript ^0.11.0;

// PassRate.cash RunTicket. One instance per ticket (payerPk is in the TICKET record).
// start(): operator may only spend it with output 0 = OP_RETURN START naming this ticket and the committed task root.
// refund(): payer reclaims after ~1 hour.
contract RunTicket(pubkey operatorPk, pubkey payerPk, bytes32 taskRoot) {
    function start(sig operatorSig) {
        require(checkSig(operatorSig, operatorPk));
        bytes script = tx.outputs[0].lockingBytecode;
        // 6a 4c 74 | "PR2" 01 'S' | mode(1) | ref(32) | refHeight(4) | taskRoot(32) ...
        require(script.length == 119);
        require(script.slice(0, 9) == 0x6a4c74505232015300);   // OP_RETURN PUSHDATA1 116 "PR2" v1 'S' mode=0 (ticket)
        // ref is in explorer (display) order; outpoint hash is in internal order.
        bytes32 ticketTxid = tx.inputs[this.activeInputIndex].outpointTransactionHash;
        require(script.slice(9, 41) == ticketTxid.reverse());
        require(script.slice(45, 77) == taskRoot);
    }

    function refund(sig payerSig) {
        require(this.age >= 6);
        require(checkSig(payerSig, payerPk));
    }
}
